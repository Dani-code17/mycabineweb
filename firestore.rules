rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Adresse e-mail exacte autorisée pour l'accès admin.
    // Doit correspondre à NEXT_PUBLIC_ADMIN_EMAIL utilisé dans le code.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email.lower() == 'chrysfavers@gmail.com';

    // Réglages publics (catalogue, lien Wave...) : tout le monde peut lire,
    // seul l'admin autorisé peut modifier.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un client peut CRÉER une demande (formulaire public) et déclarer son
    // paiement (changer status -> 'paiement_declare', si pas déjà 'traite').
    // Seul l'admin autorisé peut LIRE et modifier le reste.
    match /requests/{docId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'paiement_declare' &&
        resource.data.status != 'traite'
      );
      allow delete: if false;
    }

    // Idem pour les liens de paiement générés (création publique, lecture admin).
    match /links/{docId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
